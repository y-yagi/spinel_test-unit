#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
set -vx

# Spinel, from mise.toml.
if command -v mise >/dev/null 2>&1; then
  mise trust --quiet
  mise install
else
  echo "bin/setup: mise is not installed (https://mise.jdx.dev/)." >&2
  echo "Install Spinel yourself, and set SPINEL." >&2
fi

bundle install
